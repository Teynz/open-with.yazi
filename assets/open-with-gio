#!/usr/bin/env python3
"""GIO/XDG helper for the yazi `open-with` plugin.

All storage and discovery logic lives here; main.lua only draws menus.  Every
action prints one JSON object on stdout, so another front end (e.g. an
external TUI) can reuse this helper unchanged.

  --list    Apps that can open the given files: custom openers from the
            config file (--config) plus every desktop application GIO knows.
  --launch  Launch a desktop application with the files.
  --search  Find installed desktop applications by name.
  --add     Append a custom opener to the config file.
  --edit    Open the config file in $VISUAL/$EDITOR (creates it if missing).

We deliberately launch through GAppInfo instead of parsing the Exec= line
ourselves: GIO handles Terminal=true, field codes (%f/%F/%u/%U), flatpak apps
and startup notification for us.
"""

from __future__ import annotations

import argparse
import fnmatch
import json
import os
import shlex
import sys
import tempfile
from dataclasses import dataclass

Gio = None
GioUnix = None
GLib = None


class HelperError(RuntimeError):
    pass


def load_gio() -> None:
    global Gio, GioUnix, GLib
    if Gio is not None:
        return

    try:
        import gi

        gi.require_version("Gio", "2.0")
        from gi.repository import Gio as gio_module
        from gi.repository import GLib as glib_module

        try:
            gi.require_version("GioUnix", "2.0")
            from gi.repository import GioUnix as gio_unix_module
        except (ImportError, ValueError):
            # PyGObject < 3.50 only has Gio.DesktopAppInfo.
            gio_unix_module = None
    except Exception as exc:  # pragma: no cover - depends on host packages
        raise HelperError(f"PyGObject/GIO is not available: {exc}") from exc

    Gio = gio_module
    GioUnix = gio_unix_module
    GLib = glib_module


def clean(value: object | None) -> str:
    """Collapse whitespace so each value fits on one picker line."""
    return " ".join(str(value or "").split())


def content_type(path: str) -> str:
    """Return the GIO/shared-mime-info content type for *path*."""
    file = Gio.File.new_for_commandline_arg(path)
    try:
        info = file.query_info(
            "standard::content-type",
            Gio.FileQueryInfoFlags.NONE,
            None,
        )
        mime = info.get_content_type()
        if mime == "application/x-zerosize":
            # Empty files have no content to sniff.  Match the behaviour of
            # file managers: guess from the name, defaulting to text/plain.
            guessed, _ = Gio.content_type_guess(file.get_basename() or path, None)
            if guessed and not Gio.content_type_is_unknown(guessed):
                return guessed
            return "text/plain"
        if mime:
            return mime
    except GLib.Error:
        # Remote/virtual files may not support query_info(); fall back to a
        # name-based guess rather than failing the whole selection.
        guessed, _ = Gio.content_type_guess(file.get_basename() or path, None)
        if guessed and not Gio.content_type_is_unknown(guessed):
            return guessed
        raise HelperError(f"cannot determine MIME type: {path}")

    guessed, _ = Gio.content_type_guess(file.get_basename() or path, None)
    if guessed and not Gio.content_type_is_unknown(guessed):
        return guessed
    raise HelperError(f"cannot determine MIME type: {path}")


@dataclass
class Candidate:
    app: object
    app_id: str
    name: str
    rank: int
    is_default: bool


def add_apps(
    bucket: dict[str, Candidate],
    apps,
    rank: int,
    default_id: str | None,
) -> None:
    for app in apps or []:
        app_id = app.get_id()
        if not app_id:
            continue

        is_default = app_id == default_id
        previous = bucket.get(app_id)
        if previous is None:
            bucket[app_id] = Candidate(
                app=app,
                app_id=app_id,
                name=clean(app.get_display_name()) or clean(app.get_name()) or app_id,
                rank=rank,
                is_default=is_default,
            )
        else:
            previous.rank = min(previous.rank, rank)
            previous.is_default = previous.is_default or is_default


def app_info_list(method: str, mime: str):
    """Call an optional Gio.AppInfo class method across GLib versions."""
    fn = getattr(Gio.AppInfo, method, None)
    if fn is None:
        return []
    try:
        return fn(mime)
    except Exception:
        return []


def apps_for_type(mime: str) -> dict[str, Candidate]:
    bucket: dict[str, Candidate] = {}
    default = Gio.AppInfo.get_default_for_type(mime, False)
    default_id = default.get_id() if default else None

    if default:
        add_apps(bucket, [default], 0, default_id)
    add_apps(bucket, app_info_list("get_recommended_for_type", mime), 1, default_id)
    add_apps(bucket, app_info_list("get_fallback_for_type", mime), 2, default_id)
    add_apps(bucket, app_info_list("get_all_for_type", mime), 3, default_id)

    # Hide NoDisplay=true helpers unless they are the default; Nautilus does
    # the same.  The default app is kept even when it is hidden.
    for app_id, candidate in list(bucket.items()):
        if not candidate.is_default and not candidate.app.should_show():
            del bucket[app_id]

    return bucket


def discover(path_mimes: list[str]) -> tuple[list[str], list[dict]]:
    mimes: list[str] = []
    seen: set[str] = set()
    for mime in path_mimes:
        if mime not in seen:
            seen.add(mime)
            mimes.append(mime)

    per_type = [apps_for_type(mime) for mime in mimes]
    if not per_type:
        return [], []

    common = set(per_type[0])
    for bucket in per_type[1:]:
        common &= set(bucket)

    selected: list[Candidate] = []
    for app_id in common:
        records = [bucket[app_id] for bucket in per_type]
        candidate = records[0]
        candidate.rank = max(record.rank for record in records)
        candidate.is_default = all(record.is_default for record in records)
        selected.append(candidate)

    selected.sort(key=lambda c: (c.rank, not c.is_default, c.name.casefold(), c.app_id.casefold()))
    return mimes, [
        {
            "id": candidate.app_id,
            "name": candidate.name,
            "default": candidate.is_default,
        }
        for candidate in selected
    ]


def resolve_app(app_id: str):
    if GioUnix is not None and hasattr(GioUnix, "DesktopAppInfo"):
        app = GioUnix.DesktopAppInfo.new(app_id)
        if app:
            return app

    desktop_app_info = getattr(Gio, "DesktopAppInfo", None)
    if desktop_app_info is not None:
        app = desktop_app_info.new(app_id)
        if app:
            return app

    for app in Gio.AppInfo.get_all():
        if app.get_id() == app_id:
            return app

    return None


def launch(app_id: str, paths: list[str]) -> None:
    app = resolve_app(app_id)
    if app is None:
        raise HelperError(f"application not found: {app_id}")

    files = [Gio.File.new_for_commandline_arg(path) for path in paths]
    try:
        context = Gio.AppLaunchContext.new() if hasattr(Gio.AppLaunchContext, "new") else Gio.AppLaunchContext()
        launched = app.launch(files, context)
    except GLib.Error as exc:
        raise HelperError(f"failed to launch {app_id}: {exc}") from exc

    if launched is False:
        raise HelperError(f"GIO rejected the launch request for {app_id}")

    # Fork change (paul): opt-in only.  set_as_last_used_for_type() writes to
    # ~/.config/mimeapps.list ([Added Associations]).  For MIME types without
    # an explicit [Default Applications] entry this silently changes what
    # xdg-open launches system-wide.  Enable with OPEN_WITH_REMEMBER=1.
    if os.environ.get("OPEN_WITH_REMEMBER") != "1":
        return
    # Let GIO's "recently used" ordering work like Nautilus.  Failure here is
    # harmless, so never let it break the launch.
    for path in paths:
        try:
            app.set_as_last_used_for_type(content_type(path))
        except Exception:
            pass


# ---------------------------------------------------------------------------
# Custom openers (config file).  Pure Python, no GIO: testable on its own.
# To add a setting: accept it in normalize_entry() and emit it in public().
# ---------------------------------------------------------------------------

CONFIG_TEMPLATE = """\
# open-with.yazi - eigene Opener, erscheinen nur im Alt+O-Menue.
# Reihenfolge im Menue = Reihenfolge in dieser Datei.
#
# [[opener]]
# name   = "Okular"                  # Anzeigename
# app    = "org.kde.okular.desktop"  # Desktop-App (Start ueber GIO) ...
# run    = 'mpv --no-video %s'       # ... ODER eigener Befehl (%s = Dateien)
# mime   = "application/pdf"         # MIME-Typ(en), Muster wie "image/*" erlaubt
# ext    = ["pdf", "tar.gz"]         # und/oder Endung(en), ohne Punkt
# block  = false                     # nur bei run: im Yazi-Terminal ausfuehren
# orphan = true                      # nur bei run: von Yazi abkoppeln
#
# Ein Eintrag gilt, wenn mime ODER ext auf alle gewaehlten Dateien passt.
#
# System-Apps (aus xdg) im Alt+O-Menue ausblenden:
#
# [[hide]]
# app  = "Firefox"                   # Name wie im Menue oder Desktop-ID
# mime = "image/*"                   # optional: nur fuer diese Typen
# ext  = ["svg"]                     # optional: nur fuer diese Endungen
#
# Ohne mime/ext wird die App ueberall ausgeblendet. Die xdg-Zuordnung selbst
# bleibt unveraendert (Dolphin, xdg-open usw. sehen die App weiterhin).
"""


def as_list(value: object, field: str) -> list[str]:
    if value is None:
        return []
    if isinstance(value, str):
        return [value]
    if isinstance(value, list) and all(isinstance(item, str) for item in value):
        return list(value)
    raise ValueError(f"`{field}` muss Text oder eine Liste von Texten sein")


def normalize_entry(item: object) -> dict:
    if not isinstance(item, dict):
        raise ValueError("kein [[opener]]-Block")
    app, run = item.get("app"), item.get("run")
    if bool(app) == bool(run):
        raise ValueError("genau eines von `app` oder `run` angeben")
    if not isinstance(app or run, str):
        raise ValueError("`app`/`run` muss Text sein")
    mimes = as_list(item.get("mime"), "mime")
    exts = [e.lower().lstrip(".") for e in as_list(item.get("ext"), "ext")]
    if not mimes and not exts:
        raise ValueError("`mime` oder `ext` fehlt")
    block = bool(item.get("block", False))
    entry = {
        "name": clean(item.get("name")) or clean(app or run),
        "mime": mimes,
        "ext": [e for e in exts if e],
        "block": block,
        "orphan": bool(item.get("orphan", not block)),
    }
    entry["app" if app else "run"] = app or run
    return entry


def normalize_hide(item: object) -> dict:
    if not isinstance(item, dict):
        raise ValueError("kein [[hide]]-Block")
    app = item.get("app")
    if not app or not isinstance(app, str):
        raise ValueError("`app` fehlt")
    exts = [e.lower().lstrip(".") for e in as_list(item.get("ext"), "ext")]
    return {"app": app, "mime": as_list(item.get("mime"), "mime"),
            "ext": [e for e in exts if e]}


def hide_matches(hide: dict, path: str, mime: str) -> bool:
    if not hide["mime"] and not hide["ext"]:
        return True
    return entry_matches(hide, path, mime)


def visible_apps(apps: list[dict], hides: list[dict], paths: list[str],
                 mimes: list[str]) -> list[dict]:
    # `app` may be the desktop id or the name shown in the menu.
    hidden = {
        hide["app"].casefold()
        for hide in hides
        if all(hide_matches(hide, p, m) for p, m in zip(paths, mimes))
    }
    return [
        app for app in apps
        if app["id"].casefold() not in hidden
        and str(app.get("name", "")).casefold() not in hidden
    ]


def parse_section(data: dict, key: str, normalize, label: str,
                  errors: list[str]) -> list[dict]:
    raw = data.get(key, [])
    if not isinstance(raw, list):
        raise ValueError(f"`{key}` muss aus [[{key}]]-Bloecken bestehen")
    out = []
    for index, item in enumerate(raw, 1):
        try:
            out.append(normalize(item))
        except ValueError as exc:
            errors.append(f"{label} {index}: {exc}")
    return out


def parse_config(text: str) -> tuple[list[dict], list[str], list[dict]]:
    """Return (openers, errors, hides).  Raises ValueError on broken TOML.

    New config sections: add one parse_section() line here.
    """
    try:
        import tomllib
    except ImportError as exc:  # Python < 3.11
        raise ValueError("Python >= 3.11 noetig (tomllib)") from exc
    try:
        data = tomllib.loads(text)
    except tomllib.TOMLDecodeError as exc:
        raise ValueError(f"TOML-Fehler: {exc}") from exc

    errors: list[str] = []
    entries = parse_section(data, "opener", normalize_entry, "Eintrag", errors)
    hides = parse_section(data, "hide", normalize_hide, "hide", errors)
    return entries, errors, hides


def read_text(path: str) -> str | None:
    try:
        with open(path, encoding="utf-8") as handle:
            return handle.read()
    except FileNotFoundError:
        return None
    except OSError as exc:
        raise ValueError(f"{path}: {exc}") from exc


def load_config(path: str | None) -> tuple[list[dict], list[str], list[dict]]:
    """Like parse_config(), but never raises: problems become error strings."""
    if not path:
        return [], [], []
    try:
        text = read_text(path)
        return parse_config(text) if text is not None else ([], [], [])
    except ValueError as exc:
        return [], [f"{os.path.basename(path)}: {exc}"], []


def entry_matches(entry: dict, path: str, mime: str) -> bool:
    if any(fnmatch.fnmatchcase(mime, pattern) for pattern in entry["mime"]):
        return True
    name = os.path.basename(path).lower()
    return any(name.endswith("." + ext) for ext in entry["ext"])


def public(entry: dict) -> dict:
    """The part of an entry the front end needs to build an opener."""
    keys = ("name", "app", "run", "block", "orphan")
    return {key: entry[key] for key in keys if key in entry}


def custom_for(entries: list[dict], paths: list[str], mimes: list[str]) -> list[dict]:
    return [
        public(entry)
        for entry in entries
        if all(entry_matches(entry, p, m) for p, m in zip(paths, mimes))
    ]


def extension_of(path: str) -> str:
    name = os.path.basename(path)
    return name.rsplit(".", 1)[1].lower() if "." in name[1:] else ""


def write_atomic(path: str, text: str) -> None:
    directory = os.path.dirname(path) or "."
    os.makedirs(directory, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".open-with-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def toml_str(value: str) -> str:
    # A JSON string is a valid TOML basic string.
    return json.dumps(value, ensure_ascii=False)


def add_entry(path: str, fields: dict) -> str:
    """Append one opener.  Returns "added" or "exists"."""
    try:
        new = normalize_entry(fields)
        text = read_text(path)
        entries = parse_config(text)[0] if text is not None else []
    except ValueError as exc:
        raise HelperError(str(exc)) from exc

    target = new.get("app") or new.get("run")
    for entry in entries:
        if (entry.get("app") or entry.get("run")) == target and all(
            m in entry["mime"] for m in new["mime"]
        ) and all(e in entry["ext"] for e in new["ext"]):
            return "exists"

    lines = ["", "[[opener]]", f"name = {toml_str(new['name'])}"]
    lines.append(f"{'app' if 'app' in new else 'run'} = {toml_str(target)}")
    for key in ("mime", "ext"):
        if len(new[key]) == 1:
            lines.append(f"{key} = {toml_str(new[key][0])}")
        elif new[key]:
            lines.append(f"{key} = [{', '.join(toml_str(v) for v in new[key])}]")
    if "run" in new:
        lines.append(f"block = {str(new['block']).lower()}")
        lines.append(f"orphan = {str(new['orphan']).lower()}")

    base = text if text is not None else CONFIG_TEMPLATE
    result = base.rstrip("\n") + "\n" + "\n".join(lines) + "\n"
    try:
        parse_config(result)  # never write a file we could not read back
    except ValueError as exc:
        raise HelperError(f"neuer Eintrag ungueltig: {exc}") from exc
    try:
        write_atomic(path, result)
    except OSError as exc:
        raise HelperError(f"cannot write {path}: {exc}") from exc
    return "added"


def edit_config(path: str) -> None:
    """Replace this process with the user's editor on the config file."""
    if read_text(path) is None:
        write_atomic(path, CONFIG_TEMPLATE)
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or "nvim"
    argv = shlex.split(editor) + [path]
    os.execvp(argv[0], argv)


def search_apps(query: str, limit: int = 30) -> list[dict]:
    needle = query.casefold().strip()
    found = []
    for app in Gio.AppInfo.get_all():
        app_id = app.get_id()
        if not app_id or not app.should_show():
            continue
        name = clean(app.get_display_name()) or clean(app.get_name()) or app_id
        if needle in name.casefold() or needle in app_id.casefold():
            found.append({"id": app_id, "name": name})
    found.sort(key=lambda a: (a["name"].casefold(), a["id"].casefold()))
    return found[:limit]


def emit(payload: dict) -> None:
    sys.stdout.write(json.dumps(payload, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="List/launch desktop applications for yazi's open-with plugin."
    )
    parser.add_argument("--list", action="store_true", help="print candidate apps as JSON")
    parser.add_argument("--launch", metavar="DESKTOP_ID", help="launch a desktop application")
    parser.add_argument("--search", metavar="QUERY", help="find installed apps by name")
    parser.add_argument("--add", action="store_true", help="append a custom opener")
    parser.add_argument("--edit", action="store_true", help="edit the config file")
    parser.add_argument("--config", metavar="FILE", help="custom opener config file")
    parser.add_argument("--app", help="--add: desktop id")
    parser.add_argument("--run", help="--add: shell command instead of --app")
    parser.add_argument("--name", help="--add: display name")
    parser.add_argument("--mime", action="append", help="--add: MIME pattern")
    parser.add_argument("--ext", action="append", help="--add: file extension")
    parser.add_argument("paths", nargs="*", help="file paths (use -- before the list)")
    return parser.parse_args()


def need(value, message: str):
    if not value:
        raise HelperError(message)
    return value


def do_list(args: argparse.Namespace) -> dict:
    paths = need([p for p in args.paths if p], "no files given")
    load_gio()
    path_mimes = [content_type(path) for path in paths]
    mimes, apps = discover(path_mimes)
    entries, errors, hides = load_config(args.config)
    return {
        "mimes": mimes,
        "apps": visible_apps(apps, hides, paths, path_mimes),
        "custom": custom_for(entries, paths, path_mimes),
        "ext": extension_of(paths[0]),
        "config_errors": errors,
    }


def do_launch(args: argparse.Namespace) -> dict | None:
    paths = need([p for p in args.paths if p], "no files given")
    load_gio()
    launch(args.launch, paths)
    return None


def do_search(args: argparse.Namespace) -> dict:
    load_gio()
    return {"apps": search_apps(args.search)}


def do_add(args: argparse.Namespace) -> dict:
    need(args.config, "--config is required")
    fields = {"name": args.name, "app": args.app, "run": args.run,
              "mime": args.mime, "ext": args.ext}
    return {"status": add_entry(args.config, fields), "config": args.config}


def do_edit(args: argparse.Namespace) -> dict | None:
    edit_config(need(args.config, "--config is required"))
    return None


# First matching action wins.  New actions: add a flag above and a line here.
ACTIONS = (
    ("launch", do_launch),
    ("search", do_search),
    ("add", do_add),
    ("edit", do_edit),
    ("list", do_list),
)


def main() -> int:
    args = parse_args()
    try:
        for flag, action in ACTIONS:
            if getattr(args, flag) not in (None, False):
                payload = action(args)
                if payload is not None:
                    emit(payload)
                return 0
        emit({"error": "one of --list, --launch, --search, --add or --edit is required"})
        return 64
    except HelperError as exc:
        emit({"error": str(exc)})
        return 1
    except Exception as exc:  # pragma: no cover - defensive
        emit({"error": f"unexpected error: {exc}"})
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
